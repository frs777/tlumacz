# Maintainer: Tlumacz Team <noreply@example.invalid>
pkgname=tlumacz
pkgver=0.31.1
pkgrel=1
pkgdesc='AI-powered document translator with a Qt GUI'
arch=('any')
url='https://github.com/frs777/tlumacz'
license=('MIT')
depends=('python' 'pyside6' 'python-openai' 'python-pymupdf' 'hicolor-icon-theme')
optdepends=('python-pypdf: PDF extraction fallback'
            'pandoc: DOCX extraction fallback'
            'poppler: PDF extraction fallback'
            'python-fastapi: FastAPI backend'
            'python-uvicorn: FastAPI server'
            'python-transformers: TranslateGemma Transformers backend'
            'python-pytorch: Transformers/PyTorch backend'
            'python-psutil: process/resource monitoring'
            'openvino: OpenVINO backend'
            'openvino-genai: OpenVINO GenAI backend')
makedepends=('python-build' 'python-installer')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('aef4653ccbe9ae253b29015978f658f585b8d196e446a2a591772928ac6cb297')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 tlumacz.desktop "$pkgdir/usr/share/applications/tlumacz.desktop"
  install -Dm644 tlumacz/qt_gui/resources/tlumacz.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/tlumacz.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
