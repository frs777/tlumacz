# Maintainer: frs <frs@users.noreply.github.com>
# Build from a local source tarball (see build-aur.sh). Upload to AUR:
#   replace source with: https://github.com/frs777/tlumacz/archive/v$pkgver.tar.gz

pkgname=tlumacz
pkgver=0.21.2
pkgrel=1
pkgdesc="Narzędzie do tłumaczenia dokumentów (MD, TXT, HTML, PDF, DOCX, ODT, EPUB) za pomocą LLM z interfejsem Qt"
arch=('any')
url="https://github.com/frs777/tlumacz"
license=('MIT')
depends=(
    'python'
    'pyside6'
    'python-openai'
    'python-pymupdf'
    'hicolor-icon-theme'
)
optdepends=(
    'pandoc: ekstrakcja DOCX (docx do Markdown)'
    'llama-server: lokalny serwer LLM (GGUF)'
)
makedepends=(
    'python-build'
    'python-installer'
)
source=("tlumacz-$pkgver.tar.gz")
b2sums=('2f5924ec631615f8e4312b522207145309ce1a1a6eab8b29d416b10bf45b3cda159c1cd7607762e5d37694f10a5e0f158145ada68f9e8e46076cfe02f0ae76e8')

build() {
    cd "$srcdir"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir"
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 tlumacz.desktop "$pkgdir/usr/share/applications/tlumacz.desktop"
    install -Dm644 tlumacz/qt_gui/resources/tlumacz.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/tlumacz.svg"
}
