/* Tłumacz — light QSS stylesheet (Catppuccin Latte) */

QMainWindow, QDialog {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
}

QGroupBox {
    border: 1px solid #bcc0cc;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #e6e9ef;
    font-weight: 600;
    color: #5c5f77;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

QLineEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 6px 8px;
    color: #4c4f69;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}
QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #1e66f5;
}
QLineEdit:disabled, QPlainTextEdit:disabled {
    color: #9ca0b0;
    background-color: #e6e9ef;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #bcc0cc;
    selection-background-color: #dce0e8;
    color: #4c4f69;
}

QPushButton {
    background-color: #dce0e8;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    padding: 7px 16px;
    color: #4c4f69;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #ccd0da;
}
QPushButton:pressed {
    background-color: #bcc0cc;
}
QPushButton:disabled {
    background-color: #e6e9ef;
    border-color: #ccd0da;
    color: #9ca0b0;
}

#translateBtn {
    background-color: #1e66f5;
    border-color: #1e66f5;
    color: #ffffff;
}
#translateBtn:hover {
    background-color: #3b7bf6;
}
#translateBtn:disabled {
    background-color: #ccd0da;
    border-color: #ccd0da;
    color: #9ca0b0;
}

#cancelBtn {
    background-color: #d20f39;
    border-color: #d20f39;
    color: #ffffff;
}
#cancelBtn:hover {
    background-color: #e64553;
}
#cancelBtn:disabled {
    background-color: #ccd0da;
    border-color: #ccd0da;
    color: #9ca0b0;
}

QProgressBar {
    background-color: #ffffff;
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    height: 18px;
    text-align: center;
    color: #4c4f69;
}
QProgressBar::chunk {
    background-color: #40a02b;
    border-radius: 5px;
}

#logView {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 12px;
}

#previewView {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 12px;
    background-color: #ffffff;
}

QSplitter::handle {
    background-color: #bcc0cc;
    height: 2px;
}
QSplitter::handle:hover {
    background-color: #1e66f5;
}

QLabel {
    color: #5c5f77;
}

QStatusBar {
    background-color: #e6e9ef;
    color: #5c5f77;
}

QToolTip {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
}
